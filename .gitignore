# Application specific
.claude/
.gemini/
.sisyphus/
build-debug/
.cache/
# Local Gradle user home used by the Android build (multi-GB dependency cache)
android/.gradle_home/

# iOS cross-build trees (dependency sources and object files)
native/ios/build/
native/ios/out/
# The Mac-native simulator build (build-core-simulator.sh) and its output.
# Same reasoning as the device trees above: multi-GB of SDL/FLAC/libpng
# sources and objects, all reproducible from the script.
native/ios/build-sim/
native/ios/out-simulator/
native/ios/xcframework-stage/

# Reference zips never live in the repo; the set is kept in
# ~/Documents/retro-zips and documented in docs/ZIPS.md.
docs/*.zip
# User media stays on the device/build machine and must never enter GitHub.
Amiga-Retro/
Retro-Amiga/
# Local build and signing residue, never source
build-linux/
.artifacts/
.asc/
build-asan/

# Per-user Xcode state, written by any local build.
**/xcuserdata/
# Xcode's resolved Swift Package graph. Regenerated on every build from the
# package refs already in the project, and it records absolute paths from
# whichever machine ran the build.
**/xcshareddata/swiftpm/

# App Store Connect API private key. Account-wide, downloads from Apple
# exactly once, and cannot be rotated in place -- it never belongs in git.
*.p8
